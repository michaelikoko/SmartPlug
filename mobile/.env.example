# Copy this file to .env and replace the example values below.
# You can also set each variable in your shell before running the app.

# MQTT broker username used by the Expo app
EXPO_PUBLIC_MQTT_USERNAME=your_mqtt_username

# MQTT broker password used by the Expo app
EXPO_PUBLIC_MQTT_PASSWORD=your_mqtt_password

# Base URL for the app backend/API (for example: http://localhost:3000)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000