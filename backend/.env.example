# Copy this file to .env and replace the example values below.
# Database configuration
# Use either SQLITE_URL or POSTGRES_URL. Example SQLITE_URL: sqlite+aiosqlite:///./dev.db
SQLITE_URL=sqlite+aiosqlite:///./dev.db
# Example POSTGRES_URL: postgresql+asyncpg://user:pass@localhost:5432/dbname
POSTGRES_URL=postgresql+asyncpg://user:password@localhost:5432/smartplug

# JWT / security
ALGORITHM=HS256
# Use a strong random string in production. Example: generated by `openssl rand -hex 32`
ACCESS_TOKEN_SECRET_KEY=replace_with_access_token_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_SECRET_KEY=replace_with_refresh_token_secret
REFRESH_TOKEN_EXPIRE_DAYS=14
RESET_TOKEN_SECRET_KEY=replace_with_reset_token_secret
RESET_TOKEN_EXPIRE_MINUTES=15

# OTP (one-time password) settings
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5

# MQTT broker (for smart plug communication)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# SMTP (for sending emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=changeme
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME="Smart Plug"

# Google Smart Home / OAuth (optional)
# Client ID and secret from Google Cloud Console
GOOGLE_SMARTHOME_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_SMARTHOME_CLIENT_SECRET=your-google-client-secret
# Secret key used to sign temporary auth codes (use a random string)
GOOGLE_AUTH_CODE_SECRET_KEY=replace_with_google_auth_code_secret
# Service account JSON for HomeGraph API as a single-line JSON string or path to file
# Example: {"type":"service_account", ...} or /path/to/service-account.json
GOOGLE_HOMEGRAPH_SERVICE_ACCOUNT_JSON=